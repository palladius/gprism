#!/usr/bin/env ruby
require 'yaml'
require 'openssl'
require 'digest'
require 'fileutils'
require 'shellwords'
require 'io/console'

require 'base64'
require 'open3'

# If we are in a git repository, always run from the git root
# and convert any file path arguments to be relative to the git root.
if system("git rev-parse --is-inside-work-tree >/dev/null 2>&1")
  git_root = `git rev-parse --show-toplevel 2>/dev/null`.strip
  unless git_root.empty?
    current_dir = File.expand_path(Dir.pwd)
    
    if current_dir != git_root
      # Resolve any file arguments passed to the CLI to be relative to git_root
      ARGV.map! do |arg|
        if File.exist?(arg) && !arg.start_with?("-")
          abs_path = File.expand_path(arg)
          if abs_path.start_with?(git_root)
            abs_path.sub("#{git_root}/", "")
          else
            arg
          end
        else
          arg
        end
      end
      
      Dir.chdir(git_root)
    end
  end
end

# Terminal colors
CYAN  = "\e[36m"
GREEN = "\e[32m"
RED   = "\e[31m"
BLUE  = "\e[34m"
YELLOW = "\e[33m"
BOLD   = "\e[1m"
RESET  = "\e[0m"

VERSION_FILE = File.expand_path("../VERSION", __dir__)
GPRISM_VERSION = File.exist?(VERSION_FILE) ? File.read(VERSION_FILE).strip : "0.3.7"

if ARGV[0] == "--version" || ARGV[0] == "version" || ((ARGV[0] == "-v" || ARGV[0] == "-V") && ARGV.size == 1)
  puts "gprism #{GPRISM_VERSION}"
  exit 0
end

def info(msg) puts "#{CYAN}INFO:#{RESET} #{msg}" end
def success(msg) puts "#{GREEN}SUCCESS:#{RESET} #{msg}" end
def error(msg) puts "#{RED}ERROR:#{RESET} #{msg}"; exit 1 end
def warn(msg) puts "#{RED}WARN:#{RESET} #{msg}" end

# Config loading
def load_config
  config = {}
  yaml_path = File.expand_path("~/.config/gprism/config.yaml")
  yaml_path_alt = File.expand_path("~/.gprism.yaml")
  env_path = ".env"

  if File.exist?(yaml_path)
    config = YAML.load_file(yaml_path) || {}
  elsif File.exist?(yaml_path_alt)
    config = YAML.load_file(yaml_path_alt) || {}
  end

  # Fallback to local .env
  if File.exist?(env_path)
    File.readlines(env_path).each do |line|
      next if line.strip.empty? || line.start_with?('#')
      k, v = line.strip.split('=', 2)
      if k.start_with?("GPRISM_")
        config[k.sub("GPRISM_", "").downcase] = v
      end
    end
  end

  # Load from ENV directly if still missing
  config['project_id'] ||= ENV['GPRISM_PROJECT_ID']
  config['identity']   ||= ENV['GPRISM_IDENTITY']
  config['environment'] ||= ENV['GPRISM_ENVIRONMENT']
  config['gcs_bucket'] ||= ENV['GPRISM_GCS_BUCKET']

  config
end

def get_passphrase(env)
  env_var = "GIT_PRIVATIZE_KEY_#{env.upcase}"
  
  if ENV[env_var] || ENV['GIT_PRIVATIZE_KEY']
    if env.start_with?('test')
      warn "Cleartext password used via ENV for testing environment '#{env}'."
      return ENV[env_var] || ENV['GIT_PRIVATIZE_KEY']
    else
      warn "Cleartext password via ENV is ONLY acceptable for 'test*' environments. Ignoring ENV password and falling back to Keychain/Prompt."
    end
  end

  keychain_id = "gprism-#{env}"
  is_mac = RUBY_PLATFORM.include?('darwin')
  is_linux = RUBY_PLATFORM.include?('linux')

  # Try keychain/keyring
  out = ""
  if is_mac
    out = `security find-generic-password -s "#{keychain_id}" -a "#{keychain_id}" -w 2>/dev/null`.strip
  elsif is_linux
    if system("command -v secret-tool >/dev/null 2>&1")
      out = `secret-tool lookup service gprism account "#{keychain_id}" 2>/dev/null`.strip
    end
  end
  return out unless out.empty?

  # Prompt
  print "Enter gprism encryption passphrase for env '#{env}': "
  pass = STDIN.noecho(&:gets).chomp
  puts
  
  # For non-interactive or testing, we shouldn't block, so default to not saving if no terminal
  if STDIN.tty?
    keyring_name = is_mac ? "macOS Keychain" : (is_linux ? "Linux Keyring" : "system keyring")
    print "Save to #{keyring_name}? [Y/n] "
    ans = STDIN.gets.chomp.downcase
    if ans == 'y' || ans.empty?
      if is_mac
        `security add-generic-password -s "#{keychain_id}" -a "#{keychain_id}" -w #{Shellwords.escape(pass)} -U`
        success "Saved to Keychain."
      elsif is_linux
        if system("command -v secret-tool >/dev/null 2>&1")
          IO.popen("secret-tool store --label=\"#{keychain_id}\" service gprism account \"#{keychain_id}\"", "w") do |io|
            io.write(pass)
          end
          if $?.success?
            success "Saved to Linux Keyring."
          else
            warn "Failed to save to Linux Keyring."
          end
        else
          warn "Cannot save: secret-tool not found (install libsecret-tools)."
        end
      else
        warn "Keyring saving not implemented for this OS."
      end
    end
  end
  
  pass
end

def encrypt(data, pass)
  cipher = OpenSSL::Cipher.new('AES-256-CBC')
  cipher.encrypt
  salt = OpenSSL::Random.random_bytes(8)
  key_iv = OpenSSL::PKCS5.pbkdf2_hmac(pass, salt, 2000, cipher.key_len + cipher.iv_len, 'sha256')
  cipher.key = key_iv[0, cipher.key_len]
  cipher.iv = key_iv[cipher.key_len, cipher.iv_len]
  encrypted = cipher.update(data) + cipher.final
  Base64.strict_encode64("Salted__#{salt}#{encrypted}")
end

def decrypt(data, pass)
  decoded = Base64.strict_decode64(data.strip)
  return decoded unless decoded.start_with?("Salted__")
  salt = decoded[8, 8]
  encrypted = decoded[16..-1]
  cipher = OpenSSL::Cipher.new('AES-256-CBC')
  cipher.decrypt
  key_iv = OpenSSL::PKCS5.pbkdf2_hmac(pass, salt, 2000, cipher.key_len + cipher.iv_len, 'sha256')
  cipher.key = key_iv[0, cipher.key_len]
  cipher.iv = key_iv[cipher.key_len, cipher.iv_len]
  cipher.update(encrypted) + cipher.final
rescue => e
  error "Decryption failed! Wrong password? Error: #{e.message}"
end

def get_repo_name
  url = `git config --get remote.origin.url 2>/dev/null`.strip
  return "unknown-repo" if url.empty?
  
  if url.include?(":") && !url.start_with?("http")
    url = url.split(":", 2).last
  end
  
  url = url.sub(%r{^https?://[^/]+/}, "")
  url = url.sub(/\.git$/, "")
  url
end

def get_repo_slug
  get_repo_name.gsub(/[^a-zA-Z0-9]/, '-').gsub(/-+/, '-').sub(/^-/, '').sub(/-$/, '')
end

def generate_secret_name(filepath, env)
  repo_slug = get_repo_slug
  # Replace non-alphanumeric with dashes
  slug = filepath.gsub(/[^a-zA-Z0-9]/, '-')
  slug = slug.gsub(/-+/, '-').sub(/^-/, '').sub(/-$/, '')
  name = "#{env}--#{repo_slug}--#{slug}"
  if name.length > 255
    hash = Digest::SHA256.hexdigest(filepath)[0, 16]
    name = "#{name[0, 230]}-#{hash}"
  end
  name
end

def list_files
  return [] unless File.exist?('.git-privatize.list')
  File.readlines('.git-privatize.list').map(&:strip).reject { |l| l.empty? || l.start_with?('#') }
end

def env_opted_out?
  return false unless File.exist?('.git-privatize.list')
  File.readlines('.git-privatize.list').map(&:strip).any? { |l| l.match(/^#\s*\.env$/) }
end

def get_local_encryption_key(project, env, repo)
  name = "#{env}--#{repo}--local-encryption-key"
  if gcp_secret_exists?(project, name)
    key = fetch_gcp_secret_version(project, name)
    return key unless key.nil? || key.empty?
  end
  
  require 'securerandom'
  new_key = SecureRandom.hex(32)
  warn "A new encryption key was generated and stored in Secret Manager (#{name})."
  warn "If this secret is deleted, all your .gprenc files will be permanently lost!"
  
  create_gcp_secret(project, name)
  add_gcp_secret_version(project, name, new_key)
  new_key
end

def gcs_initialized?(bucket_name)
  system("gcloud storage buckets describe #{Shellwords.escape(bucket_name)} >/dev/null 2>&1")
end

def check_gcp_error!(project, stderr, context_msg = nil)
  return if stderr.nil? || stderr.empty?

  # Check for permission denied, invalid grant, or missing credentials
  is_auth_error = stderr.include?("PERMISSION_DENIED") ||
                  stderr.include?("does not have permission to access") ||
                  stderr.include?("invalid_grant") ||
                  stderr.include?("Token has been expired or revoked") ||
                  stderr.include?("does not have any valid credentials") ||
                  stderr.include?("reauthenticate")

  return unless is_auth_error

  active_account = ENV['CLOUDSDK_CORE_ACCOUNT']
  if active_account.nil? || active_account.empty?
    active_account = `gcloud config get-value account 2>/dev/null`.strip
  end
  active_account = "current account" if active_account.nil? || active_account.empty?

  first_line = stderr.lines.find { |l| l.include?("ERROR:") } || stderr.lines.first || ""
  summary = first_line.strip.sub(/^ERROR:\s*\([^)]+\)\s*/, '')

  # Build actionable advice based on the failure
  advice = []
  if stderr.include?("invalid_grant") || stderr.include?("Token has been expired") || stderr.include?("reauthenticate") || stderr.include?("does not have any valid credentials")
    advice << "To re-authenticate this account (gcloud CLI + ADC credentials), run:"
    if active_account != "current account"
      advice << "  #{GREEN}gcloud auth login #{Shellwords.escape(active_account)} --update-adc#{RESET}"
    else
      advice << "  #{GREEN}gcloud auth login --update-adc#{RESET}"
    end
  elsif stderr.include?("PERMISSION_DENIED") || stderr.include?("does not have permission")
    advice << "The account is logged in, but lacks permissions on GCP project '#{project}'."
    advice << "1. Verify you are using the intended account. To switch or login as another identity:"
    advice << "   #{GREEN}gcloud config set account <YOUR_EMAIL>#{RESET} (or export GPRISM_IDENTITY=<YOUR_EMAIL>)"
    advice << "2. Or ask the project owner/admin to grant roles/secretmanager.secretAccessor to #{active_account}."
  end

  error_msg = "Sorry, cannot access project '#{project}' as #{active_account}: #{summary}"
  error_msg += "\n(Action: #{context_msg})" if context_msg
  if advice.any?
    error_msg += "\n\n💡 #{BOLD}How to fix this:#{RESET}\n" + advice.join("\n")
  end
  error error_msg
end

def gcp_secret_exists?(project, name)
  stdout, stderr, status = Open3.capture3("gcloud secrets describe #{Shellwords.escape(name)} --project=#{Shellwords.escape(project)}")
  return true if status.success?

  check_gcp_error!(project, stderr, "checking if secret exists")
  false
end

def create_gcp_secret(project, secret_name)
  unless gcp_secret_exists?(project, secret_name)
    cmd = "gcloud secrets create #{Shellwords.escape(secret_name)} --replication-policy=\"automatic\" --project=#{Shellwords.escape(project)}"
    stdout, stderr, status = Open3.capture3(cmd)
    unless status.success?
      check_gcp_error!(project, stderr, "creating secret #{secret_name}")
      raise "Failed to create secret #{secret_name}:\n#{stderr}"
    end
  end
end

def add_gcp_secret_version(project, secret_name, secret_data)
  cmd = "gcloud secrets versions add #{Shellwords.escape(secret_name)} --data-file=- --project=#{Shellwords.escape(project)}"
  stdout, stderr, status = Open3.capture3(cmd, stdin_data: secret_data)
  unless status.success?
    check_gcp_error!(project, stderr, "adding version to secret #{secret_name}")
    raise "Failed to add secret version to #{secret_name}:\n#{stderr}"
  end
  true
end

def fetch_gcp_secret_version(project, name)
  stdout, stderr, status = Open3.capture3("gcloud secrets versions access latest --secret=#{Shellwords.escape(name)} --project=#{Shellwords.escape(project)}")
  if status.success?
    return stdout
  end

  check_gcp_error!(project, stderr, "accessing secret #{name}")
  nil
end

def fetch_gcp_secret_timestamp(project, name)
  stdout, stderr, status = Open3.capture3("gcloud secrets versions describe latest --secret=#{Shellwords.escape(name)} --project=#{Shellwords.escape(project)} --format=\"value(createTime)\"")
  if status.success?
    return stdout.strip
  end

  check_gcp_error!(project, stderr, "describing secret #{name}")
  ""
end

def show_diff(local_content, remote_content)
  is_binary = local_content.include?("\x00") || remote_content.include?("\x00")
  if is_binary
    puts "  (Binary file, diff not shown)"
    return
  end
  
  max_lines = [local_content.lines.size, remote_content.lines.size].max
  if max_lines <= 5
    puts "  #{BLUE}===== REMOTE =====#{RESET}"
    remote_content.each_line { |l| puts "  #{BLUE}#{l.chomp}#{RESET}" }
    puts "  #{CYAN}===== LOCAL  =====#{RESET}"
    local_content.each_line { |l| puts "  #{CYAN}#{l.chomp}#{RESET}" }
    puts "  =================="
  else
    require 'tempfile'
    Tempfile.open('gprism_local') do |loc|
      loc.write(local_content)
      loc.flush
      Tempfile.open('gprism_remote') do |rem|
        rem.write(remote_content)
        rem.flush
        require 'open3'
        stdout, _ = Open3.capture3("diff", "-u", rem.path, loc.path)
        
        # Skip the first two lines (diff header)
        lines = stdout.lines[2..-1] || []
        lines.each do |line|
          if line.start_with?('+')
            puts "  #{GREEN}#{line.chomp}#{RESET}"
          elsif line.start_with?('-')
            puts "  #{RED}#{line.chomp}#{RESET}"
          elsif line.start_with?('@')
            puts "  #{CYAN}#{line.chomp}#{RESET}"
          else
            puts "  #{line.chomp}"
          end
        end
      end
    end
  end
end

def compare_and_prompt(action, file, name, local_content, remote_content, project)
  local_md5 = Digest::MD5.hexdigest(local_content)
  remote_md5 = Digest::MD5.hexdigest(remote_content)
  
  if local_md5 == remote_md5
    info "#{file} is identical to remote secret #{name}. Skipping #{action}."
    return false
  end
  
  require 'time'
  local_time = File.mtime(file)
  remote_time_str = fetch_gcp_secret_timestamp(project, name)
  remote_time = Time.parse(remote_time_str) rescue Time.at(0)
  
  today = Time.now.strftime("%Y-%m-%d")
  fmt_time = ->(t) { t.strftime("%Y-%m-%d") == today ? t.strftime("%H:%M:%S") : t.strftime("%Y-%m-%d") }
  
  puts "Conflict for #{file}:"
  puts "  Local:  MD5 #{CYAN}#{local_md5[0, 8]}#{RESET}, modified #{fmt_time.call(local_time)}"
  puts "  Remote: MD5 #{BLUE}#{remote_md5[0, 8]}#{RESET}, modified #{fmt_time.call(remote_time)}"
  
  show_diff(local_content, remote_content)
  
  recommended = local_time > remote_time ? "push" : "pull"
  emoji = recommended == "push" ? "⬆️ " : "⬇️ "
  ours_theirs = recommended == "push" ? "(ours)" : "(theirs)"
  
  if recommended == action
    puts "  Recommended direction: #{GREEN}#{emoji} #{recommended.capitalize} #{ours_theirs}#{RESET}"
  else
    puts "  Recommended direction: #{RED}#{emoji} #{recommended.capitalize} #{ours_theirs}#{RESET} (Warning: You are trying to #{action}!)"
  end
  
  if STDIN.tty?
    print "Are you sure you want to #{action} and overwrite? [y/N] "
    ans = STDIN.gets.chomp.downcase
    return ans == 'y'
  else
    warn "Non-interactive mode, skipping #{action} due to conflict."
    return false
  end
end

def update_gitignore(files)
  gitignore = ".gitignore"
  content = File.exist?(gitignore) ? File.read(gitignore) : ""
  lines = content.split("\n").map(&:strip)
  
  needs_newline = !content.empty? && !content.end_with?("\n")
  
  File.open(gitignore, "a") do |f|
    f.puts if needs_newline
    needs_newline = false # only needed once
    
    files.each do |file|
      unless lines.include?(file)
        f.puts file
        success "Added #{file} to .gitignore"
        lines << file # Update lines array to prevent duplicates in same run
      end
    end
  end
end

def check_git_ignored_status(file)
  return :ok unless File.exist?(file)
  
  # Check if we're in a git repo first
  return :ok unless system("git rev-parse --is-inside-work-tree >/dev/null 2>&1")
  
  # Check if it's already tracked in git
  if system("git ls-files --error-unmatch #{Shellwords.escape(file)} >/dev/null 2>&1")
    return :tracked
  end
  
  # Check if it's ignored
  unless system("git check-ignore -q #{Shellwords.escape(file)} >/dev/null 2>&1")
    return :not_ignored
  end
  
  :ok
end

CONFIG = load_config
if CONFIG['identity'] && !CONFIG['identity'].empty?
  ENV['CLOUDSDK_CORE_ACCOUNT'] = CONFIG['identity']
end
env_status = check_git_ignored_status('.env')
if env_status == :tracked
  puts "#{RED}DANGER: Secret file .env is tracked in Git!#{RESET}"
  puts "#{YELLOW}Run this to fix it: (cd $(git rev-parse --show-toplevel) && git rm --cached .env)#{RESET}"
elsif env_status == :not_ignored
  warn "Hey its not git ignored: .env"
  info "Run this to fix it: (cd $(git rev-parse --show-toplevel) && echo .env >> .gitignore)"
end

if CONFIG['project_id'].nil?
  error "Project ID missing. Set GPRISM_PROJECT_ID in .env or config.yaml"
end
ENV_NS = CONFIG['environment'] || 'dev'

case ARGV[0]
when "init"
  
  unless File.exist?(".git-privatize.list")
    FileUtils.touch(".git-privatize.list")
    success "Created .git-privatize.list"
  end
  
  if File.exist?(".env")
    lines = File.readlines(".git-privatize.list").map(&:strip)
    unless lines.include?(".env") || env_opted_out?
      File.open(".git-privatize.list", "a") { |f| f.puts ".env" }
      success "Added .env to .git-privatize.list"
      update_gitignore([".env"])
    end
  end
  
  bucket_name = CONFIG['gcs_bucket'] || "gs://#{CONFIG['project_id']}-gprism"
  unless bucket_name.start_with?("gs://")
    bucket_name = "gs://#{bucket_name}"
  end
  
  info "Ensuring GCS bucket #{bucket_name} exists..."
  system("gcloud storage buckets create #{Shellwords.escape(bucket_name)} --project=#{Shellwords.escape(CONFIG['project_id'])} >/dev/null 2>&1")
  
  info "Enabling GCS object versioning..."
  if system("gcloud storage buckets update #{Shellwords.escape(bucket_name)} --versioning >/dev/null 2>&1")
    success "Initialized GCS bucket #{bucket_name} with versioning enabled."
  else
    warn "Failed to update GCS bucket. You may need to create it manually or fix your gcloud auth."
  end

when "push"
  flags = ARGV[1..-1].select { |arg| arg.start_with?("-") }
  non_flags = ARGV[1..-1].reject { |arg| arg.start_with?("-") }

  if flags.include?("--all") || flags.include?("-a")
    files = list_files
    if File.exist?('.env') && !files.include?('.env') && !env_opted_out?
      warn "Untracked secret .env detected on disk! Run 'gprism add .env' to track and push it (or 'gprism status --fix')."
    end
  else
    files = non_flags
  end

  if files.empty?
    puts "Usage: gprism push [--all|-a] [file1 file2 ...] [options]"
    exit 1
  end

  pass = get_passphrase(ENV_NS)
  files.each do |file|
    unless File.exist?(file)
      warn "File #{file} not found, skipping."
      next
    end
    
    name = generate_secret_name(file, ENV_NS)
    content = File.read(file)
    enc_content = encrypt(content, pass)
    
    if gcp_secret_exists?(CONFIG['project_id'], name)
      remote_enc_content = fetch_gcp_secret_version(CONFIG['project_id'], name)
      if remote_enc_content && !remote_enc_content.empty?
        if remote_enc_content.start_with?("GPRISM_GCS_URI=")
          gcs_uri = remote_enc_content.sub("GPRISM_GCS_URI=", "").strip
          remote_enc_content = `gcloud storage cp #{Shellwords.escape(gcs_uri)} - 2>/dev/null`
        end
        remote_content = decrypt(remote_enc_content, pass)
        force_push = flags.include?("--force") || flags.include?("-f")
        next unless force_push || compare_and_prompt("push", file, name, content, remote_content, CONFIG['project_id'])
      end
    else
      create_gcp_secret(CONFIG['project_id'], name)
    end
    
    # Handle large payloads via GCS offloading
    if enc_content.bytesize > 60_000
      bucket = CONFIG['gcs_bucket'] || "#{CONFIG['project_id']}-gprism"
      bucket = bucket.sub(/^gs:\/\//, '')
      
      filepath_slug = file.gsub(/[^a-zA-Z0-9\.\-\/]/, '_')
      gcs_uri = "gs://#{bucket}/#{ENV_NS}/#{get_repo_slug}/#{filepath_slug}.enc"
      
      info "Payload large (>60KB). Offloading to GCS: #{gcs_uri}"
      orig_md5 = Digest::MD5.hexdigest(content)
      orig_size = content.bytesize
      IO.popen("gcloud storage cp - #{Shellwords.escape(gcs_uri)} --custom-metadata=original_md5=#{orig_md5},original_size=#{orig_size} >/dev/null 2>&1", "w") do |io|
        io.write(enc_content)
      end
      unless $?.success?
        error "Failed to upload to GCS bucket #{bucket}."
      end
      # The content to push to Secret Manager becomes the pointer
      enc_content = "GPRISM_GCS_URI=#{gcs_uri}"
    end
    
    if add_gcp_secret_version(CONFIG['project_id'], name, enc_content)
      success "Pushed #{file} to Secret Manager as #{name}"
      update_gitignore([file])
      if File.exist?('.git-privatize.list')
        current_list = File.readlines('.git-privatize.list').map(&:strip)
        unless current_list.include?(file)
          File.open('.git-privatize.list', 'a') { |f| f.puts file }
          info "Added #{file} to .git-privatize.list"
        end
      end
    else
      error "Failed to push #{file}"
    end
  end

when "pupu"
  info "Running pull --all..."
  system("#{$0} pull --all")
  info "Running push --all..."
  system("#{$0} push --all")

when "pull"
  flags = ARGV[1..-1].select { |arg| arg.start_with?("-") }
  non_flags = ARGV[1..-1].reject { |arg| arg.start_with?("-") }

  if flags.include?("--all") || flags.include?("-a")
    files = list_files
  else
    files = non_flags
  end

  if files.empty?
    puts "Usage: gprism pull [--all|-a] [file1 file2 ...]"
    exit 1
  end

  pass = get_passphrase(ENV_NS)
  files.each do |file|
    name = generate_secret_name(file, ENV_NS)
    
    if !gcp_secret_exists?(CONFIG['project_id'], name)
      warn "Secret #{name} not found in GCP, skipping #{file}."
      next
    end
    
    enc_content = fetch_gcp_secret_version(CONFIG['project_id'], name)
    if enc_content.nil? || enc_content.empty?
      warn "Failed to fetch content for #{name}"
      next
    end
    
    if enc_content.start_with?("GPRISM_GCS_URI=")
      gcs_uri = enc_content.sub("GPRISM_GCS_URI=", "").strip
      info "Large payload detected. Downloading from GCS: #{gcs_uri}"
      enc_content = `gcloud storage cp #{Shellwords.escape(gcs_uri)} - 2>/dev/null`
      if !$?.success? || enc_content.nil? || enc_content.empty?
        error "Failed to download payload from GCS: #{gcs_uri}"
      end
    end
    
    dec_content = decrypt(enc_content, pass)
    
    if File.exist?(file)
      local_content = File.read(file)
      next unless compare_and_prompt("pull", file, name, local_content, dec_content, CONFIG['project_id'])
    end
    
    FileUtils.mkdir_p(File.dirname(file))
    File.delete(file) if File.exist?(file)
    File.write(file, dec_content)
    File.chmod(0400, file)
    success "Restored #{file} from GCP (read-only)"
    if File.exist?("#{file}.readme")
      File.delete("#{file}.readme")
    end
  end
  
  if flags.include?("--all") || flags.include?("-a")
    local_enc_files = Dir.glob("**/*.gprenc")
    if local_enc_files.any?
      info "Found #{local_enc_files.size} local .gprenc files. Decrypting..."
      key = get_local_encryption_key(CONFIG['project_id'], ENV_NS, get_repo_slug)
      local_enc_files.each do |enc_file|
        orig_file = enc_file.sub(/\.gprenc$/, '')
        enc_content = File.read(enc_file)
        begin
          dec = decrypt(enc_content, key)
          File.write(orig_file, dec)
          success "Restored #{orig_file} from local .gprenc"
        rescue => e
          warn "Failed to decrypt #{enc_file}: #{e.message}"
        end
      end
    end
  end

when "add"
  file = ARGV[1]
  if file.nil? || file.empty?
    puts "Usage: gprism add <filepath>"
    exit 1
  end
  
  unless File.exist?(file)
    error "File #{file} does not exist locally."
  end
  
  if File.directory?(file)
    error "Folders are not supported. Please add individual files."
  end
  
  File.chmod(0600, file)
  success "Made #{file} writable (0600)"
  
  content_preview = File.read(file, 1024) || ""
  is_large = File.size(file) > 50_000
  is_binary = content_preview.include?("\x00")
  
  if is_large || is_binary
    bucket_name = CONFIG['gcs_bucket'] || "gs://#{CONFIG['project_id']}-gprism"
    bucket_name = "gs://#{bucket_name}" unless bucket_name.start_with?("gs://")
    if gcs_initialized?(bucket_name)
      info "Large/binary file detected. This will be automatically routed to GCS during push."
    else
      error "This file is too large or binary for Secret Manager. Please run 'gprism init' to enable GCS support."
    end
  end
  
  list_file = '.git-privatize.list'
  is_new_list = !File.exist?(list_file)
  lines = is_new_list ? [] : File.readlines(list_file).map(&:strip)
  
  if is_new_list && File.exist?('.env') && file != '.env' && !env_opted_out?
    File.open(list_file, "a") { |f| f.puts ".env" }
    success "Automatically added .env to #{list_file}"
    update_gitignore([".env"])
    lines << ".env"
  end

  unless lines.include?(file)
    File.open(list_file, "a") { |f| f.puts file }
    success "Added #{file} to #{list_file}"
  else
    info "#{file} is already in #{list_file}"
  end
  
  update_gitignore([file])
  info "Run `gprism push --all` to encrypt and upload."

when "encrypt"
  files = []
  auto_yes = false
  ARGV[1..-1].each do |arg|
    if arg == "--yes" || arg == "-y" || arg == "--yes-im-sure"
      auto_yes = true
    else
      if File.directory?(arg)
        files.concat(Dir.glob("#{arg}/**/*").select { |f| File.file?(f) })
      else
        files << arg if File.file?(arg)
      end
    end
  end
  
  if files.empty?
    error "Usage: gprism encrypt <file1> <folder2> ... [--yes]"
  end
  
  if files.size > 10
    warn "You are trying to encrypt #{files.size} files. This is a lot!"
  end
  
  unless auto_yes
    warn "Are you sure you want to encrypt locally?"
    warn "Note: we have a better option to just move it to GCS via 'gprism add'! but if you can't, it's ok to do it like this."
    print "Proceed? [y/N] "
    ans = STDIN.gets.chomp.downcase
    exit 0 unless ans == 'y'
  end
  
  key = get_local_encryption_key(CONFIG['project_id'], ENV_NS, get_repo_slug)
  
  files.each do |file|
    content = File.read(file)
    enc = encrypt(content, key)
    enc_file = "#{file}.gprenc"
    File.write(enc_file, enc)
    update_gitignore([file])
    system("git add #{Shellwords.escape(enc_file)}")
    success "Encrypted #{file} -> #{enc_file} and added to git."
  end

when "decrypt"
  files = []
  ARGV[1..-1].each do |arg|
    if File.directory?(arg)
      files.concat(Dir.glob("#{arg}/**/*.gprenc").select { |f| File.file?(f) })
    else
      files << arg if File.file?(arg) || File.file?("#{arg}.gprenc")
    end
  end
  
  if files.empty?
    error "Usage: gprism decrypt <file1.gprenc> <folder2> ..."
  end
  
  key = get_local_encryption_key(CONFIG['project_id'], ENV_NS, get_repo_slug)
  
  files.each do |file|
    enc_file = file.end_with?(".gprenc") ? file : "#{file}.gprenc"
    unless File.exist?(enc_file)
      warn "Encrypted file #{enc_file} not found."
      next
    end
    orig_file = enc_file.sub(/\.gprenc$/, '')
    enc_content = File.read(enc_file)
    dec = decrypt(enc_content, key)
    File.write(orig_file, dec)
    success "Decrypted #{enc_file} -> #{orig_file}"
  end

when "status", "st"
  files = list_files
  untracked_secrets = []

  # Detect untracked .env if present locally or in Secret Manager
  unless env_opted_out? || files.include?('.env')
    env_secret_name = generate_secret_name('.env', ENV_NS)
    if File.exist?('.env') || gcp_secret_exists?(CONFIG['project_id'], env_secret_name)
      untracked_secrets << '.env'
    end
  end

  all_files = (files + untracked_secrets).uniq

  if all_files.empty?
    info "No files listed in .git-privatize.list"
    exit 0
  end
  puts "Gprism Status (Project: #{CONFIG['project_id']}, Env: #{ENV_NS})"
  
  # Carlessian alignment padding
  max_file_len = all_files.map(&:length).max || 0
  names = all_files.map { |f| generate_secret_name(f, ENV_NS) }
  max_name_len = names.map(&:length).max || 0
  
  verbose = ARGV.include?("--verbose") || ARGV.include?("-v")
  download_binaries = ARGV.include?("--download-binaries")
  
  pass = get_passphrase(ENV_NS) rescue nil
  diffs_to_show = []
  tracked_files = []
  not_ignored_files = []
  not_listed_files = []
  
  all_files.each do |file|
    is_untracked = untracked_secrets.include?(file)
    not_listed_files << file if is_untracked

    status_sym = check_git_ignored_status(file)
    tracked_files << file if status_sym == :tracked
    not_ignored_files << file if status_sym == :not_ignored
    
    name = generate_secret_name(file, ENV_NS)
    
    # 1. Fetch remote payload directly (saves a gcloud call)
    payload = fetch_gcp_secret_version(CONFIG['project_id'], name)
    
    remote_type = nil
    gcs_uri = nil
    if payload && !payload.empty?
      if payload.start_with?("GPRISM_GCS_URI=")
        remote_type = "🪣 GS"
        gcs_uri = payload.sub("GPRISM_GCS_URI=", "").strip
        if download_binaries
          payload = `gcloud storage cp #{Shellwords.escape(gcs_uri)} - 2>/dev/null`
        else
          payload = nil # Skip diffing
        end
      else
        remote_type = "🔑 SM"
      end
    end
    
    local_exists = File.exist?(file)
    readme_exists = File.exist?("#{file}.readme")
    
    # 2. Compute Sync state
    sync_state = nil
    if remote_type == "🪣 GS" && !download_binaries && local_exists
      # Check sync state via GCS custom metadata
      require 'json'
      meta_json = `gcloud storage objects describe #{Shellwords.escape(gcs_uri)} --format="json(custom_fields)" 2>/dev/null`
      unless meta_json.strip.empty?
        begin
          parsed = JSON.parse(meta_json)
          meta = (parsed.is_a?(Hash) ? parsed['custom_fields'] : nil) || {}
          remote_md5 = meta['original_md5']
          remote_size = meta['original_size']&.to_i
          
          local_content = File.read(file)
          local_md5 = Digest::MD5.hexdigest(local_content)
          local_size = local_content.bytesize
          
          if remote_md5.nil? || remote_md5.empty?
            sync_state = "#{YELLOW}❓ Unk#{RESET}"
          elsif local_md5 == remote_md5 && local_size == remote_size
            sync_state = "#{GREEN}✅ Sync#{RESET}"
          else
            sync_state = "#{YELLOW}⚠️ M   #{RESET}"
            # Don't show diff for binaries without downloading
          end
        rescue JSON::ParserError
          sync_state = "#{YELLOW}❓ Unk#{RESET}"
        end
      else
        sync_state = "#{YELLOW}❓ Unk#{RESET}"
      end
    elsif remote_type && payload && pass
      remote_content = decrypt(payload, pass)
      
      # Always download to .gprism/remote/
      remote_path = File.join(".gprism/remote", file)
      FileUtils.mkdir_p(File.dirname(remote_path))
      File.write(remote_path, remote_content)
      
      if local_exists
        local_content = File.read(file)
        local_md5 = Digest::MD5.hexdigest(local_content)
        remote_md5 = Digest::MD5.hexdigest(remote_content)
        
        if local_md5 == remote_md5
          sync_state = "#{GREEN}✅ Sync#{RESET}"
        else
          sync_state = "#{YELLOW}⚠️ M   #{RESET}"
          diffs_to_show << { file: file, local: local_content, remote: remote_content }
        end
      else
        sync_state = "#{RED}❌ Miss#{RESET}"
      end
    elsif local_exists && !remote_type
      sync_state = "#{RED}❌ Miss#{RESET}"
    end
    
    status = []
    status << "#{YELLOW}⚠️ Untracked#{RESET}" if is_untracked
    status << sync_state if sync_state
    
    if remote_type
      status << "#{GREEN}#{remote_type}#{RESET}"
    else
      status << "#{RED}❌ Remote#{RESET}"
    end
    status << "#{GREEN}💻 Local#{RESET}" if local_exists
    status << "#{RED}❌ Local#{RESET}" unless local_exists
    status << "#{CYAN}📝 Readme#{RESET}" if readme_exists
    
    pad_file = " " * [0, max_file_len - file.length].max
    pad_name = " " * [0, max_name_len - name.length].max
    
    colorized_file = file
    if File.symlink?(file)
      colorized_file = "#{CYAN}#{file}#{RESET}"
    elsif File.directory?(file)
      colorized_file = "#{BLUE}#{file}#{RESET}"
    elsif File.exist?(file) && File.executable?(file)
      colorized_file = "#{GREEN}#{file}#{RESET}"
    end
    
    puts "💾 #{colorized_file}#{pad_file} -> #{name}#{pad_name} [ #{status.join(' | ')} ]"
  end
  
  local_enc_files = Dir.glob("**/*.gprenc")
  local_enc_files.each do |enc_file|
    orig_file = enc_file.sub(/\.gprenc$/, '')
    
    pad_file = " " * [0, max_file_len - orig_file.length].max
    pad_name = " " * [0, max_name_len - enc_file.length].max
    
    status = []
    status << "#{GREEN}🔐 GP#{RESET}"
    local_exists = File.exist?(orig_file)
    status << "#{GREEN}💻 Local#{RESET}" if local_exists
    status << "#{RED}❌ Local#{RESET}" unless local_exists
    
    colorized_file = orig_file
    if File.exist?(orig_file) && File.executable?(orig_file)
      colorized_file = "#{GREEN}#{orig_file}#{RESET}"
    end
    
    puts "💾 #{colorized_file}#{pad_file} -> #{enc_file}#{pad_name} [ #{status.join(' | ')} ]"
  end
  
  if diffs_to_show.any?
    puts "\n#{YELLOW}⚠️ Modified Files (Diffs) ⚠️#{RESET}"
    diffs_to_show.each do |d|
      puts "\n#{CYAN}--- #{d[:file]} ---#{RESET}"
      show_diff(d[:local], d[:remote])
    end
    puts "\n#{YELLOW}💡 Hint: #{diffs_to_show.size} file(s) have local modifications (M).#{RESET}"
    puts "#{CYAN}   To inspect details & MD5s: #{RESET}gprism show <filepath> (or gprism diff <filepath>)"
    puts "#{CYAN}   To push local changes    : #{RESET}gprism push -a"
    puts "#{CYAN}   To restore from remote   : #{RESET}gprism pull -a"
  end
  
  auto_fix = ARGV.include?("--git-ignore") || ARGV.include?("--fix")
  
  if tracked_files.any?
    puts "\n#{RED}DANGER: #{tracked_files.size} secret file(s) are tracked in Git!#{RESET}"
    cmd = "(cd $(git rev-parse --show-toplevel) && git rm --cached " + tracked_files.map { |f| Shellwords.escape(f) }.join(" ") + ")"
    if auto_fix
      puts "#{YELLOW}Auto-fixing tracked files: #{cmd}#{RESET}"
      system(cmd)
    else
      puts "#{YELLOW}Run this to fix it: #{cmd}#{RESET}"
    end
  end
  
  if not_ignored_files.any?
    puts "\n#{YELLOW}WARN: #{not_ignored_files.size} file(s) are not git ignored!#{RESET}"
    files_str = not_ignored_files.map { |f| Shellwords.escape(f) }.join(" ")
    cmd = "(cd $(git rev-parse --show-toplevel) && printf \"%s\\n\" #{files_str} >> .gitignore)"
    if auto_fix
      puts "#{YELLOW}Auto-fixing gitignore: #{cmd}#{RESET}"
      system(cmd)
    else
      puts "#{YELLOW}Run this to fix it: #{cmd}#{RESET}"
    end
  end

  if not_listed_files.any?
    puts "\n#{YELLOW}WARN: #{not_listed_files.size} secret file(s) exist but are NOT tracked in .git-privatize.list!#{RESET}"
    not_listed_files.each do |f|
      puts "  - #{CYAN}#{f}#{RESET}"
    end
    cmd = "(cd $(git rev-parse --show-toplevel) && printf \"%s\\n\" " + not_listed_files.map { |f| Shellwords.escape(f) }.join(" ") + " >> .git-privatize.list)"
    if auto_fix
      puts "#{YELLOW}Auto-fixing .git-privatize.list: #{cmd}#{RESET}"
      system(cmd)
      update_gitignore(not_listed_files)
    else
      puts "#{YELLOW}Run this to track them: #{cmd} (or run 'gprism status --fix')#{RESET}"
    end
  end

when "list", "ls"
  require 'json'
  
  show_all = false
  repo_filter = nil
  raw_repo = nil
  
  ARGV[1..-1].each_with_index do |arg, i|
    if arg == "--all" || arg == "-a"
      show_all = true
    elsif arg == "--repo" || arg == "-r"
      raw_repo = ARGV[i+2]
      # Slugify user's input the same way we slugify URLs (e.g. github/palladius -> github-palladius)
      repo_filter = raw_repo.gsub(/[^a-zA-Z0-9]/, '-').gsub(/-+/, '-').sub(/^-/, '').sub(/-$/, '') if raw_repo
    end
  end
  
  # Default to current repo if no explicit filters are passed
  if !show_all && repo_filter.nil?
    repo_filter = get_repo_slug 
    repo_display_name = get_repo_name
  else
    repo_display_name = raw_repo || repo_filter
  end
  
  puts "#{CYAN}Fetching secrets from GCP Project: #{CONFIG['project_id']}...#{RESET}"
  stdout, stderr, status = Open3.capture3("gcloud secrets list --project=#{Shellwords.escape(CONFIG['project_id'])} --format=json")
  unless status.success?
    check_gcp_error!(CONFIG['project_id'], stderr, "listing secrets")
    warn "Failed to fetch secrets: #{stderr.strip}"
    exit 0
  end
  secrets_json = stdout
  if secrets_json.strip.empty?
    warn "No secrets found."
    exit 0
  end
  
  begin
    secrets = JSON.parse(secrets_json)
  rescue JSON::ParserError
    error "Failed to parse secrets list JSON."
  end
  
  count = 0
  matched_secrets = []
  local_files = list_files
  
  secrets.each do |s|
    secret_name = s["name"].split("/").last
    
    unless show_all
      # Must match env and repo
      if repo_filter
        next unless secret_name.start_with?("#{ENV_NS}--#{repo_filter}--")
      else
        next unless secret_name.start_with?("#{ENV_NS}--")
      end
    end
    
    version_id = `gcloud secrets versions list #{Shellwords.escape(secret_name)} --project=#{Shellwords.escape(CONFIG['project_id'])} --limit=1 --format="value(name)" 2>/dev/null`.strip.split("/").last
    
    if version_id.nil? || version_id.empty?
      puts "🔒 #{secret_name} - #{RED}No versions found#{RESET}"
      next
    end
    
    payload = fetch_gcp_secret_version(CONFIG['project_id'], secret_name)
    size = payload ? payload.bytesize : 0
    size_str = size > 1024 ? "#{size / 1024}KB" : "#{size}B"
    
    if payload && payload.start_with?("GPRISM_GCS_URI=")
      gcs_uri = payload.sub("GPRISM_GCS_URI=", "").strip
      puts "🔑 #{BLUE}#{secret_name}#{RESET} (v#{version_id}) - 🪣 #{CYAN}GS#{RESET} (#{gcs_uri.split('/').last})"
    else
      puts "🔑 #{BLUE}#{secret_name}#{RESET} (v#{version_id}) - 🔑 #{CYAN}SM#{RESET} (#{size_str})"
    end
    
    # Try to extract friendly name
    friendly_name = nil
    if repo_filter
      prefix = "#{ENV_NS}--#{repo_filter}--"
      if secret_name.start_with?(prefix)
        local_match = local_files.find { |f| generate_secret_name(f, ENV_NS) == secret_name }
        if local_match
          friendly_name = local_match
        else
          file_slug = secret_name[prefix.length..-1]
          file_slug = ".#{file_slug[1..-1]}" if file_slug.start_with?("-")
          friendly_name = file_slug
        end
      else
        friendly_name = secret_name
      end
    else
      friendly_name = secret_name
    end
    matched_secrets << friendly_name
    
    count += 1
  end
  
  msg = "\nFound #{count} secrets"
  msg += " for env '#{ENV_NS}'" unless show_all
  msg += " and repo '#{repo_display_name}'" if repo_display_name
  
  if count > 0
    msg += ":\n" + matched_secrets.map { |f| "- #{f}" }.join("\n")
  else
    msg += "."
  end
  
  puts msg

  # --- GCS Server-Side Listing ---
  bucket_name = CONFIG['gcs_bucket'] || "gs://#{CONFIG['project_id']}-gprism"
  unless bucket_name.start_with?("gs://")
    bucket_name = "gs://#{bucket_name}"
  end
  
  puts "\n#{CYAN}Checking GCS storage for repo '#{repo_display_name}' in env '#{ENV_NS}'...#{RESET}"
  gcs_path = "#{bucket_name}/#{ENV_NS}/#{repo_filter}/"
  gcs_output = `gcloud storage ls #{Shellwords.escape(gcs_path)} 2>/dev/null`.strip
  
  if gcs_output.empty?
    puts "No offloaded files found in GCS bucket."
  else
    puts "🪣 Remote GCS blobs:"
    gcs_output.split("\n").each do |line|
      next if line.strip.empty? || !line.start_with?("gs://")
      # line is like gs://bucket/dev/repo/path_slug.enc
      file_path = line.sub(gcs_path, "")
      puts "  - #{GREEN}#{file_path}#{RESET} (in GCS)"
    end
  end

when "show", "inspect", "diff", "describe"
  file = ARGV[1]
  if file.nil? || file.empty?
    puts "Usage: gprism #{ARGV[0]} <filepath>"
    exit 1
  end
  
  name = generate_secret_name(file, ENV_NS)
  puts "\n🔍 #{CYAN}Inspecting file:#{RESET} #{GREEN}#{file}#{RESET} (Project: #{CONFIG['project_id']}, Env: #{ENV_NS})"
  puts "─" * 75
  puts "📍 #{BOLD}Secret Name#{RESET} : #{name}"

  local_exists = File.exist?(file)
  remote_exists = gcp_secret_exists?(CONFIG['project_id'], name)

  remote_type = "❌ None"
  remote_md5 = nil
  remote_size = nil
  remote_time = nil
  versions_count = 0
  gcs_uri = nil
  remote_content = nil

  if remote_exists
    v_out, _, _ = Open3.capture3("gcloud secrets versions list #{Shellwords.escape(name)} --project=#{Shellwords.escape(CONFIG['project_id'])} --format='value(name)' 2>/dev/null")
    versions_count = v_out.lines.size
    remote_time = fetch_gcp_secret_timestamp(CONFIG['project_id'], name)
    enc_content = fetch_gcp_secret_version(CONFIG['project_id'], name)
    
    if enc_content && !enc_content.empty?
      if enc_content.start_with?("GPRISM_GCS_URI=")
        gcs_uri = enc_content.sub("GPRISM_GCS_URI=", "").strip
        remote_type = "🪣 GS"
        raw_gcs = `gcloud storage cp #{Shellwords.escape(gcs_uri)} - 2>/dev/null`
        if $?.success? && raw_gcs && !raw_gcs.empty?
          pass = get_passphrase(ENV_NS)
          remote_content = decrypt(raw_gcs, pass) rescue nil
        end
      else
        remote_type = "🔑 SM"
        pass = get_passphrase(ENV_NS)
        remote_content = decrypt(enc_content, pass) rescue nil
      end
      if remote_content
        remote_md5 = Digest::MD5.hexdigest(remote_content)
        remote_size = remote_content.bytesize
      end
    end
  end

  local_md5 = nil
  local_size = nil
  local_time = nil
  local_content = nil
  if local_exists
    local_content = File.read(file)
    local_md5 = Digest::MD5.hexdigest(local_content)
    local_size = local_content.bytesize
    local_time = File.mtime(file).strftime("%Y-%m-%d %H:%M:%S")
  end

  status_badge = if !local_exists && !remote_exists
                   "#{RED}❌ Missing Everywhere#{RESET}"
                 elsif !local_exists
                   "#{RED}❌ Missing Local#{RESET} (exists remote)"
                 elsif !remote_exists
                   "#{RED}❌ Missing Remote#{RESET} (untracked or not pushed)"
                 elsif local_md5 == remote_md5 && remote_md5
                   "#{GREEN}✅ Sync#{RESET} (identical)"
                 else
                   "#{YELLOW}⚠️ M  #{RESET} (modified vs remote)"
                 end

  puts "🏛️  #{BOLD}Pillar#{RESET}      : #{remote_type}"
  puts "📊 #{BOLD}Status#{RESET}      : #{status_badge}"
  puts "\n💻 #{BOLD}HERE (Local)#{RESET}"
  if local_exists
    puts "   ├─ #{BOLD}Path#{RESET}     : #{file}"
    puts "   ├─ #{BOLD}Size#{RESET}     : #{local_size} bytes"
    puts "   ├─ #{BOLD}Modified#{RESET} : #{local_time}"
    puts "   └─ #{BOLD}MD5#{RESET}      : #{CYAN}#{local_md5}#{RESET}"
  else
    puts "   └─ #{RED}File not found on local disk.#{RESET}"
  end

  puts "\n☁️  #{BOLD}THERE (Remote #{remote_type})#{RESET}"
  if remote_exists
    puts "   ├─ #{BOLD}Secret ID#{RESET}: #{name}"
    puts "   ├─ #{BOLD}GCS URI#{RESET}  : #{gcs_uri}" if gcs_uri
    puts "   ├─ #{BOLD}Versions#{RESET} : #{versions_count} version(s) in Secret Manager"
    puts "   ├─ #{BOLD}Updated#{RESET}  : #{remote_time || 'Unknown'}"
    match_str = (local_md5 == remote_md5 && local_md5) ? "#{GREEN}[ ✅ MATCHES LOCAL ]#{RESET}" : "#{RED}[ ⚠️ DOES NOT MATCH LOCAL ]#{RESET}"
    puts "   └─ #{BOLD}MD5#{RESET}      : #{CYAN}#{remote_md5 || 'N/A'}#{RESET}  #{match_str}"
  else
    puts "   └─ #{RED}Secret not found in GCP Secret Manager.#{RESET}"
  end

  if local_exists && remote_exists && local_content && remote_content && local_md5 != remote_md5
    puts "\n" + "─" * 75
    puts "📝 #{BOLD}Difference Details (TEXTUAL File Diff: HERE vs THERE):#{RESET}"
    puts "   #{RED}[ - ] Red lines   #{RESET}= #{BOLD}THERE#{RESET} (Remote version stored in GCP #{remote_type})"
    puts "   #{GREEN}[ + ] Green lines #{RESET}= #{BOLD}HERE#{RESET}  (Local modified version on disk: #{file})"
    show_diff(local_content, remote_content)
    puts "─" * 75
    puts "💡 #{BOLD}Hint:#{RESET} Local differs from remote! To overwrite remote with local changes, run: #{GREEN}gprism push #{file}#{RESET} (or gprism push --force)"
    puts "         To overwrite local changes with remote version, run: #{GREEN}gprism pull #{file}#{RESET}"
  elsif local_exists && !remote_exists
    puts "\n💡 #{BOLD}Hint:#{RESET} To push this new file to remote, run: #{GREEN}gprism add #{file} && gprism push #{file}#{RESET}"
  elsif !local_exists && remote_exists
    puts "\n💡 #{BOLD}Hint:#{RESET} To pull this file from remote, run: #{GREEN}gprism pull #{file}#{RESET}"
  else
    puts "\n✨ #{GREEN}Everything is in sync!#{RESET}"
  end

when "help", "--help", "-h", nil
  puts <<~HELP
    gprism - A Git-Privatize replacement using GCP Secret Manager & Cloud Storage

    Usage:
      gprism <command> [options]

    Commands:
      init               Initialize the environment, create .env.template, and set up GCS bucket.
      add <file>         Add a file to be tracked and encrypted. (0600 permissions will be set).
      show, inspect <file> Show HERE vs THERE MD5 hashes, timestamps, SM version count, and diffs.
      push [-a|--all] [file...] Encrypt and push tracked files to GCP. Large files (>50KB) route to GCS.
      pull [-a|--all] [file...] Decrypt and pull tracked files from GCP, overwriting local copies.
      encrypt            Locally encrypt files/folders to `.gprenc` and auto git add. Supports `--yes`.
      decrypt            Locally decrypt `.gprenc` files. Usually handled automatically by `pull -a`.
      status, st         Show the status of tracked files (local vs remote).
      list, ls           List files tracked in GCP for the current environment and repository.
                         Use `--all` to show all repositories.
      help               Show this help message.
      --version, -v      Show gprism version.
      --ai-help          Show AI-friendly CLI documentation.

    Environment Variables:
      GPRISM_PROJECT_ID    Your GCP project ID.
      GPRISM_ENVIRONMENT   The environment namespace (default: dev).
      GPRISM_GCS_BUCKET    (Optional) Override default GCS bucket name.
      GIT_PRIVATIZE_KEY_*  Passphrases for your environments.

  HELP

when "--ai-help"
  puts <<~AI_HELP
    # gprism AI Help Documentation
    
    `gprism` is a CLI tool that encrypts local repository secrets using a symmetric key, then uploads them to GCP Secret Manager (for small text files) or GCS (for large/binary files).
    
    ## Commands
    - `gprism init`: Creates `.env.template`, `.git-privatize.list`, and creates a GCS bucket (with versioning) named `gs://$PROJECT_ID-gprism`.
    - `gprism add <filepath>`: Adds a file to `.git-privatize.list`. Will intelligently halt if the file is > 50KB or binary AND the GCS bucket is not initialized, encouraging the user to run `gprism init`.
    - `gprism show <filepath>` (aliases: `inspect`, `diff`): Displays HERE vs THERE comparison including MD5 checksums, Secret Manager version counts, timestamps, and unified diffs when out of sync.
    - `gprism push [--all|-a] [file...]`: Encrypts and pushes files (either all tracked files or the specified files) to GCP. If encrypted payload > 60KB, pushes to GCS and puts a pointer in Secret Manager.
    - `gprism pull [--all|-a] [file...]`: Decrypts and pulls files from GCP, restoring plaintext files.
    - `gprism encrypt <files>`: Encrypts files offline, adds original to `.gitignore`, and automatically `git add`s the `.gprenc` file. Uses an auto-generated SM key. Use `--yes` to bypass warnings.
    - `gprism decrypt <files>`: Decrypts `.gprenc` files. (Mostly for troubleshooting, as `pull --all` does this automatically).
    - `gprism status` (or `st`): Compares local `.git-privatize.list` against the remote Secret Manager to show synchronization status (`✅ Sync` or `⚠️ M`). Also detects and lists local `*.gprenc` files.
    - `gprism list` (or `ls`): Queries GCP Secret Manager and GCS directly to list all secrets for the current repository and environment. Can be filtered with `--all`.
    - `gprism --version`: Prints gprism version.
    
    ## Storage Paradigm
    - Small Text Files (< 50KB): Encrypted and stored natively in Google Secret Manager.
    - Large / Binary Files: Encrypted and stored in Google Cloud Storage with object versioning. Secret Manager just stores the GCS pointer (e.g. `GPRISM_GCS_URI=gs://...`).
  AI_HELP

else
  puts "Usage: gprism [init|add|show|inspect|diff|push|pull|encrypt|decrypt|status|st|list|ls|help|version|--version] <args>"
end
